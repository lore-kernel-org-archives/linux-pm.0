/* A simple linux kernel module */

/* Include the required headers */
#include <linux/module.h>
#include <linux/kernel.h>
#include <linux/acpi.h>
#include <linux/slab.h>
#include <asm/uaccess.h>
#include <asm/rtc.h>

void do=5Facpi=5Fstuff( void );
void print=5Facpi=5Fbuffer (acpi=5Fstring);
void print=5Facpi=5Fint (acpi=5Fstring);
void print=5Facpi=5Fstring  (acpi=5Fstring);
void print=5Facpi=5Fint2 (acpi=5Fstring);
void print=5Facpi=5Finteger (acpi=5Fstring);
void print=5Facpi=5Fstring2  (acpi=5Fstring);
void setup=5Fpmem=5Freboot (void);
void unsetup=5Fpmem=5Freboot (void);
void show=5Fcmos (void);
void cmos=5Fsetsize(void);

MODULE=5FPARM=5FDESC(choice, "A short integer");
MODULE=5FPARM=5FDESC(data, "Unsigned Long");

static short choice =3D 0;
static long data =3D 0;

module=5Fparam(choice , short, S=5FIRUSR | S=5FIWUSR | S=5FIRGRP | S=5FIWGR=
P);
module=5Fparam(data , long, S=5FIRUSR | S=5FIWUSR | S=5FIRGRP | S=5FIWGRP);

/* The module initialisation function */
int init=5Fmodule(void)
{

        printk(KERN=5FEMERG "Simple module inserted. Choice =3D %d, Data =
=3D %X \n", choice, data);

        /* extracting acpi namespace information */
        switch ( choice ) {
        case 1 : show=5Fcmos();
                 break ;

        case 2 : setup=5Fpmem=5Freboot();
                 break ;

        case 3 : unsetup=5Fpmem=5Freboot();
                 break ;

        case 4 : cmos=5Fsetsize();
                 break ;

        case 5 : do=5Facpi=5Fstuff();
                 break ;

        default :  printk(KERN=5FEMERG "Invalid choice" );
                 break;
        }

        return 0;
}

/* The module cleanup function */
void cleanup=5Fmodule()
{
        printk(KERN=5FEMERG "Removing simple module.\n");
}

void setup=5Fpmem=5Freboot (void)
{
        int temp =3D 0;
        outb ( 0xDD, 0x72);
        temp =3D inb ( 0x73 );
        printk(KERN=5FEMERG "Pmem=5Freboot =3D %d ", temp );
        temp =3D temp | 0x10 ;
        printk(KERN=5FEMERG "Pmem=5Freboot =3D %d ", temp );
        outb (0xDD, 0x72);
        outb (temp , 0x73 );
}
